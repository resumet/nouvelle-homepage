{
  "name": "nouver-hotel-jongno",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "assets:og": "node scripts/generate-og.mjs",
    "assets:photos": "node scripts/prepare-photos.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "node scripts/verify-build.mjs",
    "audit:mobile": "lighthouse http://127.0.0.1:4321/ --output=json --output-path=artifacts/lighthouse-mobile.json --chrome-flags=\"--headless --no-sandbox --disable-gpu\" --quiet --only-categories=performance,accessibility,best-practices,seo",
    "audit:summary": "node scripts/lighthouse-summary.mjs",
    "release:check": "node --experimental-strip-types scripts/check-release.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.8",
    "@fontsource/noto-serif-kr": "5.3.1",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@fontsource/playfair-display": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "pretendard": "1.3.9",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@types/node": "26.6.5",
    "lighthouse": "13.6.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
