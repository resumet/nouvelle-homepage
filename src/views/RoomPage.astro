---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import RoomGallery from '../components/RoomGallery.astro';
import BookingButton from '../components/BookingButton.astro';
import TextLines from '../components/TextLines.astro';
import type { Room } from '../data/rooms';
import { localePath, type Locale } from '../i18n/config';
import { getMessages } from '../i18n/messages';
interface Props { locale: Locale; room: Room; other: Room; }
const { locale, room, other } = Astro.props;
const m = getMessages(locale);
const c = m.room;
const roomCopy = room.copy[locale];
---
<BaseLayout locale={locale} title={`${room.name} · ${roomCopy.title}`} description={`${roomCopy.title}. ${room.area}㎡, ${m.common.cityView}, ${room.count} ${m.common.roomsUnit}. ${roomCopy.description}`} breadcrumbs={[{ label: c.breadcrumb, path: 'rooms/' }, { label: room.name, path: `rooms/${room.slug}/` }]}>
  <PageHeading title={roomCopy.title} subtitle={room.name.toUpperCase()} description={roomCopy.description} />
  <div class="container"><RoomGallery images={room.images} label={room.name} locale={locale} /></div>
  <section class="container room-details page-section"><div><h2>{c.detailsTitle}</h2><p class="muted">{c.detailsBody}</p><dl class="spec-list"><div><dt>{c.labels.area}</dt><dd>{room.area}㎡</dd></div><div><dt>{c.labels.view}</dt><dd>{m.common.cityView}</dd></div><div><dt>{c.labels.bed}</dt><dd>{room.bed[locale]}</dd></div><div><dt>{c.labels.bathtub}</dt><dd>{c.bathtub}</dd></div><div><dt>{c.labels.bookingName}</dt><dd>{room.bookingName[locale]}</dd></div><div><dt>{c.labels.count}</dt><dd>{room.count} {m.common.roomsUnit}</dd></div></dl><p class="small muted">{c.separate}</p></div><aside class="room-booking"><h3>{c.bookingTitle}</h3><p><TextLines text={c.bookingBody} /></p><BookingButton locale={locale} /><p class="small muted">{c.bookingNote}</p></aside></section>
  <div class="container related-room"><span class="muted">{c.other}</span><a href={localePath(locale, `rooms/${other.slug}/`)}>{other.name} <span aria-hidden="true">↗</span></a><a class="text-link" href={localePath(locale, 'rooms/')}>{c.back} <span aria-hidden="true">←</span></a></div>
</BaseLayout>
