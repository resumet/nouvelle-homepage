---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { localePath, type Locale } from '../i18n/config';
import { getMessages } from '../i18n/messages';
interface Props { locale: Locale; kind: 'privacy' | 'terms'; }
const { locale, kind } = Astro.props;
const m = getMessages(locale);
const c = m[kind];
---
<BaseLayout locale={locale} title={c.seoTitle} description={c.seoDescription} breadcrumbs={[{ label: c.breadcrumb, path: `${kind}/` }]}>
  <PageHeading title={c.title} subtitle={kind === 'privacy' ? 'PRIVACY POLICY' : 'TERMS OF USE'} />
  <article class="container legal-content"><p class="muted">{c.updated}</p>{c.sections.map((section, index) => <><h2>{section.h}</h2><p>{section.p}{kind === 'privacy' && index === 3 && <> <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">{m.privacy.githubPrivacy}</a></>}{kind === 'privacy' && index === 4 && <> <a href={localePath(locale, 'contact/')}>{m.privacy.contactLink}</a></>}</p></>)}</article>
</BaseLayout>
