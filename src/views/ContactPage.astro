---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import BookingButton from '../components/BookingButton.astro';
import { hotel, hotelText, telephoneHref } from '../data/hotel';
import { localePath, type Locale } from '../i18n/config';
import { getMessages } from '../i18n/messages';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const m = getMessages(locale);
const c = m.contact;
const hotelCopy = hotelText[locale];
---
<BaseLayout locale={locale} title={c.seoTitle} description={c.seoDescription} breadcrumbs={[{ label: c.breadcrumb, path: 'contact/' }]}>
  <PageHeading title={c.title} subtitle="CONTACT & INFORMATION" description={c.description} />
  <section class="container page-section contact-layout"><div><h2>{hotelCopy.name}</h2><dl class="contact-list"><div><dt>{c.labels.location}</dt><dd>{hotelCopy.address || hotelCopy.region}</dd></div><div><dt>{c.labels.phone}</dt><dd><a href={telephoneHref}>{hotel.phone}</a></dd></div><div><dt>{c.labels.email}</dt><dd class="contact-emails">{hotel.emails.map(email => <a href={`mailto:${email}`}>{email}</a>)}</dd></div></dl><a class="text-link" href={localePath(locale, 'location/')}>{c.directions} <span aria-hidden="true">↗</span></a></div><div class="policy-panel"><h3>{c.reservation}</h3><p>{c.reservationBody}</p><BookingButton locale={locale} /></div></section>
  <section class="section surface"><div class="container faq"><h2>{c.guide}</h2>{c.faqs.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
</BaseLayout>
