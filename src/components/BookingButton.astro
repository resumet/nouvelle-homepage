---
import { bookingUrlForLocale, canBook } from '../data/booking';
import { type Locale } from '../i18n/config';
import { getMessages } from '../i18n/messages';
interface Props { label?: string; locale?: Locale; variant?: 'gold' | 'outline'; class?: string; }
const { locale = 'ko', variant = 'gold', class: className = '' } = Astro.props;
const m = getMessages(locale);
const label = Astro.props.label ?? m.common.bookNow;
const bookingUrl = bookingUrlForLocale(locale);
---
{canBook ? (
  <a class:list={['button', `button-${variant}`, className]} href={bookingUrl} target="_blank" rel="noopener noreferrer" aria-label={`${label} · ${m.common.bookingNewTab}`}>
    {label}<span aria-hidden="true">↗</span>
  </a>
) : (
  <button class:list={['button', `button-${variant}`, 'booking-pending', className]} disabled title="Booking.com 호텔 예약 링크를 준비하고 있습니다.">
    <span>{label}<span class="booking-status">예약 링크 준비 중</span></span>
  </button>
)}
