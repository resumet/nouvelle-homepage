---
import type { Attraction } from '../data/attractions';
import { googleMap } from '../data/attractions';
import MediaFrame from './MediaFrame.astro';
import { attractionCredits } from '../data/attraction-photos';
import { type Locale } from '../i18n/config';
import { getMessages } from '../i18n/messages';
interface Props { attraction: Attraction; index: number; locale?: Locale; }
const { attraction, index, locale = 'ko' } = Astro.props;
const m = getMessages(locale);
const credit = attractionCredits[attraction.slug as keyof typeof attractionCredits];
---
<article class="attraction-card">
  {attraction.image && <MediaFrame image={attraction.image} alt={attraction.name[locale]} label={attraction.name[locale]} kind="city" locale={locale} />}
  {credit && <div class="photo-credit"><a href={credit.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`${m.common.photo}: ${credit.author} · ${attraction.name[locale]}`}>{m.common.photo}: {credit.author}</a><span aria-hidden="true"> · </span><a href={credit.licenseUrl} target="_blank" rel="noopener noreferrer" aria-label={`${credit.license} · ${m.common.license}`}>{credit.license}</a></div>}
  <div class="attraction-top"><span class="attraction-purpose">{attraction.purpose[locale]}</span><span class="attraction-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div>
  <h3>{attraction.name[locale]}</h3><p>{attraction.description[locale]}</p><div class="attraction-bottom"><span class="muted small">{attraction.location[locale]}</span><a href={googleMap(attraction.query)} target="_blank" rel="noopener noreferrer" aria-label={`${attraction.name[locale]} ${m.common.mapView} · ${m.common.mapNewTab}`}>{m.common.mapView} <span aria-hidden="true">↗</span></a></div>
</article>
