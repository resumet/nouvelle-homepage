---
import type { Room } from '../data/rooms';
import MediaFrame from './MediaFrame.astro';
import { localePath, type Locale } from '../i18n/config';
import { getMessages } from '../i18n/messages';
interface Props { room: Room; locale?: Locale; }
const { room, locale = 'ko' } = Astro.props;
const m = getMessages(locale);
---
<article class="room-card">
  <a class="room-image-link" href={localePath(locale, `rooms/${room.slug}/`)}><MediaFrame image={room.images[0]} label={room.name} locale={locale} /><span class="sr-only"> · {room.name} {m.common.detail}</span></a>
  <div class="room-card-content"><div class="room-card-title"><h3><a href={localePath(locale, `rooms/${room.slug}/`)}>{room.name}</a></h3><span>{room.area}<small>㎡</small></span></div>
  <p class="room-tagline">{room.copy[locale].title}</p>
  <div class="room-card-bottom"><span class="muted">{m.common.cityView} <span class="separator">/</span> {room.count}{m.common.roomsUnit} <span class="separator">/</span> {room.feature[locale]}</span><a class="circle-link" href={localePath(locale, `rooms/${room.slug}/`)} aria-label={`${room.name} ${m.common.detail}`}>↗</a></div></div>
</article>
