---
import type { Room } from '../data/rooms';
import MediaFrame from './MediaFrame.astro';
import { withBase } from '../utils/paths';
interface Props { room: Room; headingLevel?: 'h2' | 'h3'; }
const { room, headingLevel: Heading = 'h3' } = Astro.props;
---
<article class="room-card">
  <a class="room-image-link" href={withBase(`rooms/${room.slug}/`)}><MediaFrame image={room.images[0]} label={room.name} /><span class="sr-only"> · {room.name} 상세 보기</span></a>
  <div class="room-card-content"><div class="room-card-title"><Heading><a href={withBase(`rooms/${room.slug}/`)}>{room.name}</a></Heading><span>{room.area}<small>㎡</small></span></div>
  <p class="room-tagline">{room.bookingName}</p>
  <div class="room-card-bottom"><p class="muted">{room.feature}<br />시티뷰, {room.count}실</p><a class="text-link" href={withBase(`rooms/${room.slug}/`)} aria-label={`${room.name} 객실 보기`}>객실 보기 <span aria-hidden="true">→</span></a></div></div>
</article>
