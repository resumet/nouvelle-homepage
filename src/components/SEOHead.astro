---
import { hotel } from '../data/hotel';
import { withBase } from '../utils/paths';
interface Props { title: string; description: string; noindex?: boolean; canonicalPath?: string; breadcrumbs?: { label: string; path: string }[]; }
const { title, description, noindex = false, canonicalPath, breadcrumbs = [] } = Astro.props;
const site = Astro.site!;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site).href;
const root = new URL(withBase(), site).href;
const graph: Record<string, unknown>[] = [{ '@type': 'Hotel', '@id': `${root}#hotel`, name: hotel.name, alternateName: hotel.englishName, url: root, ...(hotel.address ? { address: { '@type': 'PostalAddress', streetAddress: hotel.address, addressCountry: 'KR' } } : {}), ...(hotel.phone ? { telephone: hotel.phone } : {}), ...(hotel.email ? { email: hotel.email } : {}), numberOfRooms: hotel.totalRooms }];
if (breadcrumbs.length) graph.push({ '@type': 'BreadcrumbList', itemListElement: [{ label: '홈', path: '' }, ...breadcrumbs].map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.label, item: new URL(withBase(item.path), site).href })) });
---
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} | {hotel.name}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="theme-color" content="#333333" /><meta property="og:type" content="website" /><meta property="og:locale" content="ko_KR" /><meta property="og:site_name" content={hotel.name} /><meta property="og:title" content={`${title} | ${hotel.name}`} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(withBase('images/og.png'), site).href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="NOUVER HOTEL & SPA JONGNO 브랜드 로고" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={`${title} | ${hotel.name}`} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL(withBase('images/og.png'), site).href} />
<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} /><link rel="manifest" href={withBase('site.webmanifest')} />
{!noindex && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />}
