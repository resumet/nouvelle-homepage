---
import BookingButton from './BookingButton.astro';
import { brandCaption, brandWordmark, officialEnglishName } from '../data/hotel';
import { contentPath, localeMeta, localePath, publishedLocales, type Locale } from '../i18n/config';
import { getMessages } from '../i18n/messages';
interface Props { locale?: Locale; }
const { locale = 'ko' } = Astro.props;
const m = getMessages(locale);
const links = [{ path: '', label: m.common.nav.home }, { path: 'rooms/', label: m.common.nav.rooms }, { path: 'facilities/', label: m.common.nav.bath }, { path: 'location/', label: m.common.nav.location }, { path: 'explore/', label: m.common.nav.explore }];
const current = contentPath(Astro.url.pathname);
const languageTarget = current.startsWith('404') ? '' : current;
const isActive = (path: string) => path ? current.startsWith(path) : current === '';
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={localePath(locale)} aria-label={m.common.homeAria}>
      <span>{brandWordmark}</span>
      <span class="wordmark-caption">{brandCaption}</span>
    </a>
    <nav class="desktop-nav" aria-label={m.common.mainNav}>
      {links.map(({ path, label }) => <a href={localePath(locale, path)} aria-current={isActive(path) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <nav class="language-switcher" aria-label={m.common.language}>{publishedLocales.map(item => <a href={localePath(item, languageTarget)} lang={localeMeta[item].htmlLang} aria-current={item === locale ? 'true' : undefined}>{localeMeta[item].shortLabel}</a>)}</nav>
    <div class="header-actions"><BookingButton locale={locale} /><button class="menu-toggle" aria-label={m.common.menuOpen} aria-controls="mobile-menu" aria-expanded="false"><span></span><span></span></button></div>
  </div>
</header>
<dialog id="mobile-menu" class="mobile-menu" aria-label={m.common.mainNav}>
  <div class="mobile-menu-top"><span class="eyebrow">{officialEnglishName.toUpperCase()}</span><button class="menu-close" aria-label={m.common.menuClose}>×</button></div>
  <nav aria-label={m.common.mobileNav}>{links.map(({ path, label }) => <a href={localePath(locale, path)} aria-current={isActive(path) ? 'page' : undefined}>{label}<span aria-hidden="true">↗</span></a>)}</nav>
  <nav class="mobile-languages" aria-label={m.common.language}>{publishedLocales.map(item => <a href={localePath(item, languageTarget)} lang={localeMeta[item].htmlLang} aria-current={item === locale ? 'true' : undefined}>{localeMeta[item].label}</a>)}</nav>
  <a class="text-link" href={localePath(locale, 'contact/')}>{m.common.contact} <span aria-hidden="true">↗</span></a>
</dialog>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => { menu.showModal(); toggle.setAttribute('aria-expanded', 'true'); document.body.classList.add('modal-open'); });
    menu.querySelector('.menu-close')?.addEventListener('click', () => menu.close());
    menu.addEventListener('click', (event) => { if (event.target === menu) menu.close(); });
    menu.addEventListener('close', () => { toggle.setAttribute('aria-expanded', 'false'); document.body.classList.remove('modal-open'); toggle.focus(); });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => { if (event.matches && menu.open) menu.close(); });
  }
</script>
