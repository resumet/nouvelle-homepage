---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import MediaFrame from '../components/MediaFrame.astro';
import RoomCard from '../components/RoomCard.astro';
import AttractionCard from '../components/AttractionCard.astro';
import { hotel, copy } from '../data/hotel';
import { rooms } from '../data/rooms';
import { attractions } from '../data/attractions';
import { withBase } from '../utils/paths';
---
<BaseLayout title="도심 속 휴식, 트렌디함을 입힌 하루" description="서울 종로5가의 누베르 호텔 앤 스파 종로점. 디럭스와 프리미엄 스위트, 프리미엄 사운드, 지하 프라이빗 욕장에서 만나는 도심 속 휴식.">
  <section class:list={['home-hero', { 'hero-with-photo': !!hotel.heroImage }]}>
    {hotel.heroImage && <img class="hero-photo" src={withBase(hotel.heroImage.src)} alt={hotel.heroImage.alt} width={hotel.heroImage.width} height={hotel.heroImage.height} fetchpriority="high" loading="eager" />}
    <div class="container hero-inner"><div class="hero-copy"><p class="eyebrow">URBAN RETREAT, ELEVATED COMFORT</p><h1>도심 속 휴식,<br />트렌디함을 입힌 하루<span class="gold">.</span></h1><p class="hero-subtitle">{copy.ko.subtitle}</p><div class="hero-buttons"><BookingButton /><a class="button button-hero-outline" href={withBase('rooms/')}>EXPLORE ROOMS <span aria-hidden="true">↗</span></a></div></div>
    {!hotel.heroImage && <div class="hero-art" aria-label="누베르 브랜드 그래픽, 호텔 실사진 준비 중"><div class="hero-art-frame"><span class="hero-monogram" aria-hidden="true">N</span><span class="hero-art-wordmark" aria-hidden="true">NOUVER</span></div><span class="hero-art-note">브랜드 그래픽 · 호텔 실사진 준비 중</span></div>}
    </div>
  </section>
  <section class="intro-section container"><div class="intro-heading"><p class="eyebrow">A NEW WAY TO STAY</p><h2>종로의 중심에서 만나는<br />새로운 휴식<span class="gold">.</span></h2></div><div class="intro-content"><p>익숙한 도시에서 발견하는 새로운 여유.<br />누베르는 종로의 일상과 여행 사이에<br class="desktop-break" /> 감각적인 쉼표를 더합니다.</p><p class="muted">30개의 객실, 공간을 채우는 프리미엄 사운드,<br class="desktop-break" /> 그리고 나만의 속도로 즐기는 프라이빗한 휴식.</p><a class="text-link" href={withBase('location/')}>서울 종로5가에서 만나요 <span aria-hidden="true">↗</span></a></div></section>
  <section class="section surface"><div class="container"><div class="section-heading"><p class="eyebrow">ROOMS &amp; SUITES</p><h2>머무는 순간, 나다운 편안함.</h2><p>여행의 취향에 맞춰 선택하는 두 가지 공간.</p></div><div class="room-grid">{rooms.map(room => <RoomCard room={room} />)}</div><div class="section-action"><a class="text-link" href={withBase('rooms/')}>모든 객실 살펴보기 <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section container sound-section"><div class="sound-visual"><MediaFrame image={hotel.soundImage} label="Premium Sound" kind="sound" /></div><div class="sound-copy"><span class="section-kicker">PREMIUM SOUND</span><h2>공간을 채우는 사운드,<br />특별해지는 휴식.</h2><p>좋아하는 음악이 흐르는 공간.<br />프리미엄 스피커로 누베르에서의 시간을<br class="desktop-break" /> 조금 더 감각적으로 채워보세요.</p><p class="small muted">스피커 제공 객실 및 제품 정보는 확인 후 안내합니다.</p><a class="text-link" href={withBase('rooms/')}>객실 둘러보기 <span aria-hidden="true">↗</span></a></div></section>
  <section class="bath-section surface"><div class="container"><div class="bath-header"><p class="eyebrow">PRIVATE BATH</p><h2>오직 두 사람을 위한<br />프라이빗한 휴식.</h2><p>분주했던 하루의 끝, 두 사람만의 공간에서 느끼는 여유.</p></div><MediaFrame image={hotel.bathImages[0]} label="Private Bath" kind="bath" /><div class="bath-bottom"><dl class="bath-facts"><div><dt>위치</dt><dd>지하층</dd></div><div><dt>운영시간</dt><dd>24시간</dd></div><div><dt>이용 인원</dt><dd>최대 2인</dd></div></dl><a class="text-link" href={withBase('facilities/')}>프라이빗 욕장 자세히 보기 <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section container"><div class="section-heading"><p class="eyebrow">DISCOVER JONGNO</p><h2>서울의 중심에서 시작하는 여행.</h2><p>시장의 활기부터 궁궐의 고요함까지, 종로의 다채로운 표정을 만나보세요.</p></div><div class="attraction-grid home-attractions">{attractions.slice(0, 3).map((attraction, index) => <AttractionCard attraction={attraction} index={index} />)}</div><div class="section-action"><a class="text-link" href={withBase('explore/')}>주변 여행지 모두 보기 <span aria-hidden="true">↗</span></a></div></section>
  <section class="stay-invitation"><div class="container"><span class="section-kicker">YOUR NEXT STAY</span><h2>다음 여행의 쉼표,<br />누베르.</h2><BookingButton /><p class="muted small">객실 예약은 Booking.com에서 안내합니다.</p></div></section>
</BaseLayout>
