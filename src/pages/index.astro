---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import MediaFrame from '../components/MediaFrame.astro';
import RoomCard from '../components/RoomCard.astro';
import AttractionCard from '../components/AttractionCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { hotel, directions } from '../data/hotel';
import { rooms } from '../data/rooms';
import { attractions } from '../data/attractions';
import { withBase } from '../utils/paths';
---
<BaseLayout title="도심 속 휴식, 트렌디함을 입힌 하루" description="서울 종로5가의 누베르 호텔 앤 스파 종로점. 디럭스와 프리미엄 스위트, 프리미엄 사운드, 지하 프라이빗 욕장에서 만나는 도심 속 휴식.">
  <section class="home-hero container">
    <div class="hero-copy">
      <p class="hero-location">서울 종로5가</p>
      <h1>도심 속 휴식,<br />트렌디함을 입힌 하루</h1>
      <p class="hero-subtitle">종로5가역에서 도보 약 5분.<br />모든 객실에 원형 욕조를 갖추었습니다.</p>
      <div class="hero-buttons"><BookingButton /><a class="text-link" href={withBase('rooms/')}>객실 살펴보기 <span aria-hidden="true">→</span></a></div>
    </div>
    <figure class="hero-visual">
      <ResponsiveImage image={hotel.heroImage} priority sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) 55vw, 760px" />
      <figcaption><span>Suite Room</span><a href={withBase('rooms/premium-suite/')}>스위트 사진 보기 <span aria-hidden="true">→</span></a></figcaption>
    </figure>
  </section>

  <section class="home-rooms section container" aria-labelledby="rooms-heading">
    <div class="section-heading"><h2 id="rooms-heading">원형 욕조가 있는 객실</h2><p>디럭스와 스위트, 두 가지 공간에 모두 원형 욕조가 있습니다.</p></div>
    <div class="room-grid">{rooms.map(room => <RoomCard room={room} />)}</div>
    <div class="sound-detail">
      <MediaFrame image={hotel.soundImage} label="Premium Sound" kind="sound" sizes="(max-width: 767px) calc(100vw - 40px), 320px" />
      <div><h3>객실에서 즐기는 프리미엄 사운드</h3><p>좋아하는 음악과 함께 머무는 시간.<br />객실에 마련된 사운드 시스템을 만나보세요.</p><p class="small muted">스피커 제공 객실과 제품 정보는 문의해 주세요.</p></div>
    </div>
  </section>

  <section class="home-bath container" aria-labelledby="bath-heading">
    <MediaFrame image={hotel.bathImages[0]} label="Private Bath" kind="bath" sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1439px) calc(100vw - 112px), 1328px" />
    <div class="bath-story">
      <div><h2 id="bath-heading">지하 프라이빗 욕장</h2><p>최대 두 사람을 위한 독립된 공간입니다.<br />객실 안의 원형 욕조와는 별도로 이용합니다.</p><a class="text-link" href={withBase('facilities/')}>욕장 사진과 이용 안내 <span aria-hidden="true">→</span></a></div>
      <dl class="bath-facts"><div><dt>위치</dt><dd>지하층</dd></div><div><dt>운영시간</dt><dd>24시간</dd></div><div><dt>이용 인원</dt><dd>최대 2인</dd></div></dl>
    </div>
  </section>

  <section class="section container home-neighborhood" aria-labelledby="neighborhood-heading">
    <div class="section-heading"><h2 id="neighborhood-heading">종로에서 보내는 하루</h2><p>광장시장부터 종묘, DDP까지. 호텔을 거점으로 서울을 둘러보세요.</p></div>
    <div class="local-guide">{attractions.slice(0, 3).map((attraction, index) => <AttractionCard attraction={attraction} compact={index > 0} />)}</div>
    <a class="text-link neighborhood-more" href={withBase('explore/')}>주변 여행지 모두 보기 <span aria-hidden="true">→</span></a>
  </section>

  <section class="arrival-section" aria-labelledby="arrival-heading">
    <div class="container arrival-inner">
      <MediaFrame image={hotel.lobbyImage} label="Hotel Lobby" sizes="(max-width: 767px) calc(100vw - 40px), 420px" />
      <div class="arrival-copy"><h2 id="arrival-heading">종로5가역에서 도보 약 {directions.subwayWalkMinutes}분</h2><p>{hotel.address}</p><a class="text-link" href={withBase('location/')}>오시는 길과 교통 안내 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
</BaseLayout>
