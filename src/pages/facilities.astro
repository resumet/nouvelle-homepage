---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import RoomGallery from '../components/RoomGallery.astro';
import { hotel } from '../data/hotel';
import { withBase } from '../utils/paths';
---
<BaseLayout title="프라이빗 욕장" description="누베르 호텔 종로점 지하 프라이빗 욕장. 최대 2인, 24시간 운영하는 별도의 휴식 공간을 만나보세요." breadcrumbs={[{ label: '프라이빗 욕장', path: 'facilities/' }]}>
  <PageHeading title="두 사람만의 공간에서 누리는 깊은 휴식." subtitle="PRIVATE BATH" description="도심의 분주함을 잠시 내려놓고, 함께하는 시간에 집중해 보세요." />
  <div class="container"><RoomGallery images={hotel.bathImages} label="Private Bath" kind="bath" /></div>
  <section class="container page-section facility-details"><div><h2>오롯이 쉬어가는 시간.</h2><p class="muted">지하층에 마련된 독립적인 프라이빗 욕장입니다.</p><dl class="spec-list"><div><dt>위치</dt><dd>지하층</dd></div><div><dt>운영시간</dt><dd>24시간</dd></div><div><dt>이용 인원</dt><dd>최대 2인</dd></div><div><dt>시설 형태</dt><dd>프라이빗 욕장</dd></div></dl></div><div class="policy-panel"><h3>이용 전 확인해 주세요.</h3><p>이용 요금, 사전 예약 및 회차 운영 방식은 확정 후 안내합니다.</p><p>프리미엄 스위트 객실 내 2인용 욕탕과는 별도 시설입니다.</p><p>마사지 및 스파 트리트먼트는 제공하지 않습니다.</p><a class="text-link" href={withBase('contact/')}>문의 및 안내 <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
