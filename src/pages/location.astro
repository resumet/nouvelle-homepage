---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { hotel, directions } from '../data/hotel';
import { googleMap, naverMap } from '../data/attractions';
import { withBase } from '../utils/paths';
---
<BaseLayout title="오시는 길" description={`${hotel.address}에 위치한 누베르 호텔 앤 스파 종로점. 종로5가역 도보 약 5분, 버스·지하철·차량 방문 안내와 지도를 확인하세요.`} breadcrumbs={[{ label: '오시는 길', path: 'location/' }]}>
  <PageHeading title="여행과 일상이 만나는 종로." subtitle="FIND US IN JONGNO" description="누베르에서 시작하는 서울 여행. 종로5가에서 만나요." />
  <section class="container page-section location-layout">
    <div class="location-panel"><span class="section-kicker">NOUVER JONGNO</span><h2>서울, 종로5가.</h2><dl class="contact-list"><div><dt>호텔명</dt><dd>{hotel.name}</dd></div><div><dt>주소</dt><dd>{hotel.address}</dd></div><div><dt>가까운 역</dt><dd>{directions.subwayStation}에서 도보 약 {directions.subwayWalkMinutes}분</dd></div></dl><div class="map-buttons"><a class="button button-gold" href={hotel.mapsUrl || googleMap(hotel.address)} target="_blank" rel="noopener noreferrer" aria-label="Google 지도 · 호텔 주소 검색, 새 탭에서 열기">Google 지도 <span aria-hidden="true">↗</span></a><a class="button button-outline" href={naverMap(hotel.address)} target="_blank" rel="noopener noreferrer" aria-label="네이버 지도 · 호텔 주소 검색, 새 탭에서 열기">네이버 지도 <span aria-hidden="true">↗</span></a></div><a class="text-link" href={withBase('contact/')}>문의 및 안내 <span aria-hidden="true">↗</span></a></div>
    <div class="walking-panel"><h2>걸어서 만나는 종로.</h2><dl class="walking-list">{directions.walking.map(place => <div><dt>{place.name}</dt><dd>약 <span>{place.minutes}</span>분</dd></div>)}</dl><p class="small muted">호텔 안내 기준이며, 선택한 경로와 보행 속도에 따라 달라질 수 있습니다.</p></div>
  </section>
  <section class="section surface"><div class="container"><div class="section-heading"><h2>편한 방법으로 찾아오세요.</h2></div><div class="directions-grid">
    <article><h3>지하철</h3><p>{directions.subwayStation}에서 하차한 뒤,<br />호텔까지 도보 약 {directions.subwayWalkMinutes}분입니다.</p><a class="text-link" href={naverMap(hotel.address)} target="_blank" rel="noopener noreferrer">지도에서 경로 확인 <span aria-hidden="true">↗</span></a></article>
    <article><h3>버스</h3><p><b>{directions.busStop}</b><br />정거장에서 하차해 주세요.</p><ul class="bus-routes" aria-label="이용 가능한 버스 노선">{directions.busRoutes.map(route => <li>{route}</li>)}</ul></article>
    <article><h3>차량</h3><p>이용하시는 내비게이션에서<br /><b>{directions.navigationQuery}</b>을 검색해 주세요.</p><p class="small muted">구글맵·카카오맵·아이나비·티맵에서 호텔명으로 검색할 수 있습니다. 주차 이용 정책은 확인 후 안내합니다.</p></article>
  </div></div></section>
</BaseLayout>
