---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { hotel } from '../data/hotel';
import { googleMap, naverMap } from '../data/attractions';
import { withBase } from '../utils/paths';
---
<BaseLayout title="오시는 길" description="서울 종로5가에 위치한 누베르 호텔 앤 스파 종로점. 확정된 위치 및 교통 정보와 지도 안내를 확인하세요." breadcrumbs={[{ label: '오시는 길', path: 'location/' }]}>
  <PageHeading title="여행과 일상이 만나는 종로." subtitle="FIND US IN JONGNO" description="누베르에서 시작하는 서울 여행. 종로5가에서 만나요." />
  <section class="container page-section location-layout"><div class="location-panel"><span class="section-kicker">NOUVER JONGNO</span><h2>서울, 종로5가.</h2><dl class="contact-list"><div><dt>호텔명</dt><dd>{hotel.name}</dd></div><div><dt>주소</dt><dd>{hotel.address || '서울 종로5가 · 상세 도로명주소 안내 준비 중'}</dd></div><div><dt>교통</dt><dd>정확한 경로와 교통편을 확인하여 안내하겠습니다.</dd></div></dl>{hotel.address ? <div class="map-buttons"><a class="button button-gold" href={hotel.mapsUrl || googleMap(hotel.address)} target="_blank" rel="noopener noreferrer">Google 지도 <span aria-hidden="true">↗</span></a><a class="button button-outline" href={naverMap(hotel.address)} target="_blank" rel="noopener noreferrer">네이버 지도 <span aria-hidden="true">↗</span></a></div> : <p class="notice">정확한 호텔 위치를 확인하고 있습니다.<br />상세 주소와 호텔 지도는 확인 후 제공합니다.</p>}<a class="text-link" href={withBase('contact/')}>문의 및 안내 <span aria-hidden="true">↗</span></a></div><div class="location-region"><span class="region-label">SEOUL</span><strong>JONGNO<span class="gold">.</span></strong><p>서울 종로5가</p><span class="small muted">지역 안내 · 호텔 위치 지도는 준비 중입니다.</span></div></section>
</BaseLayout>
