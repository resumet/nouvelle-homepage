---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---
<BaseLayout title="페이지를 찾을 수 없습니다" description="요청하신 페이지를 찾을 수 없습니다. 누베르 호텔 종로점 홈페이지에서 다시 안내해 드립니다." noindex canonicalPath={withBase('404.html')}>
  <div class="container not-found"><span class="error-number">404</span><h1>잠시, 길을 잃으셨나요?</h1><p class="muted">페이지가 이동되었거나 주소가 올바르지 않습니다.</p><div class="hero-buttons"><a class="button button-gold" href={withBase()}>홈으로 돌아가기 <span aria-hidden="true">↗</span></a><a class="button button-outline" href={withBase('rooms/')}>객실 둘러보기</a></div></div>
</BaseLayout>
