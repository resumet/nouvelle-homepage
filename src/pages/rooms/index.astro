---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import RoomCard from '../../components/RoomCard.astro';
import BookingButton from '../../components/BookingButton.astro';
import { rooms } from '../../data/rooms';
---
<BaseLayout title="객실 안내" description="각 25㎡의 디럭스 더블룸과 스위트룸. 모든 객실에 원형 욕조를 갖춘 누베르 호텔 종로점의 두 가지 객실을 비교해 보세요." breadcrumbs={[{ label: '객실 안내', path: 'rooms/' }]}>
  <PageHeading title="머무는 순간, 나다운 편안함." subtitle="ROOMS & SUITES" description="도시의 풍경을 곁에 두고, 나의 취향에 맞는 휴식을 선택하세요." />
  <section class="container page-section"><div class="room-grid">{rooms.map(room => <RoomCard room={room} headingLevel="h2" />)}</div></section>
  <section class="section surface"><div class="container"><div class="section-heading"><h2>두 가지 공간, 같은 편안함.</h2><p>모든 객실에 마련된 원형 욕조와 함께 나다운 휴식을 선택하세요.</p></div><div class="comparison-wrap"><table class="comparison-table"><caption class="sr-only">디럭스와 스위트 객실 비교</caption><thead><tr><th scope="col">객실 안내</th>{rooms.map(room => <th scope="col">{room.name}</th>)}</tr></thead><tbody><tr><th scope="row">예약 사이트 객실명</th>{rooms.map(room => <td>{room.bookingName}</td>)}</tr><tr><th scope="row">면적</th>{rooms.map(room => <td>{room.area}㎡</td>)}</tr><tr><th scope="row">침대</th>{rooms.map(room => <td>{room.bed}</td>)}</tr><tr><th scope="row">전망</th><td>시티뷰</td><td>시티뷰</td></tr><tr><th scope="row">객실 내 욕조</th>{rooms.map(room => <td>{room.feature}</td>)}</tr></tbody></table></div><p class="small muted comparison-note">지하 프라이빗 욕장은 객실 내 원형 욕조와 별도 시설입니다. 예약 시 객실별 투숙 정원과 이용 조건을 확인해 주세요.</p><BookingButton /></div></section>
</BaseLayout>
