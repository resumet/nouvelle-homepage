---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import RoomCard from '../../components/RoomCard.astro';
import BookingButton from '../../components/BookingButton.astro';
import { rooms } from '../../data/rooms';
---
<BaseLayout title="객실 안내" description="25㎡ 디럭스 27실과 객실 내 2인용 욕탕을 갖춘 48㎡ 프리미엄 스위트 3실. 누베르 호텔 종로점의 두 가지 객실을 비교해 보세요." breadcrumbs={[{ label: '객실 안내', path: 'rooms/' }]}>
  <PageHeading title="머무는 순간, 나다운 편안함." subtitle="ROOMS & SUITES" description="도시의 풍경을 곁에 두고, 나의 취향에 맞는 휴식을 선택하세요." />
  <section class="container page-section"><div class="room-grid">{rooms.map(room => <RoomCard room={room} />)}</div></section>
  <section class="section surface"><div class="container"><div class="section-heading"><h2>두 가지 공간, 같은 편안함.</h2><p>객실의 여유와 욕탕 구성을 비교해 보세요.</p></div><div class="comparison-wrap"><table class="comparison-table"><caption class="sr-only">디럭스와 프리미엄 스위트 비교</caption><thead><tr><th scope="col">객실 안내</th>{rooms.map(room => <th scope="col">{room.name}</th>)}</tr></thead><tbody><tr><th scope="row">면적</th>{rooms.map(room => <td>{room.area}㎡</td>)}</tr><tr><th scope="row">전망</th><td>시티뷰</td><td>시티뷰</td></tr><tr><th scope="row">객실 수</th>{rooms.map(room => <td>{room.count}실</td>)}</tr><tr><th scope="row">대표 특징</th><td>감각적인 인테리어</td><td>객실 내 2인용 욕탕</td></tr></tbody></table></div><p class="small muted comparison-note">객실별 정원, 침대 구성 및 이용 정책은 확정 후 안내합니다. 지하 프라이빗 욕장은 객실 내 욕탕과 별도 시설입니다.</p><BookingButton /></div></section>
</BaseLayout>
