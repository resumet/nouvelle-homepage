---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import RoomGallery from '../../components/RoomGallery.astro';
import BookingButton from '../../components/BookingButton.astro';
import { rooms } from '../../data/rooms';
import { withBase } from '../../utils/paths';
export function getStaticPaths() { return rooms.map(room => ({ params: { slug: room.slug }, props: { room } })); }
const { room } = Astro.props;
const other = rooms.find(item => item.slug !== room.slug)!;
---
<BaseLayout title={room.name} description={`${room.copy.ko.title}. ${room.area}㎡, 시티뷰, ${room.count}실. ${room.copy.ko.description}`} breadcrumbs={[{ label: '객실 안내', path: 'rooms/' }, { label: room.name, path: `rooms/${room.slug}/` }]}>
  <PageHeading title={room.copy.ko.title} subtitle={room.name.toUpperCase()} description={room.copy.ko.description} />
  <div class="container"><RoomGallery images={room.images} label={room.name} /></div>
  <section class="container room-details page-section"><div><h2>휴식을 위한 공간.</h2><p class="muted">도시의 하루를 보내고, 편안하게 돌아올 곳.</p><dl class="spec-list"><div><dt>객실 면적</dt><dd>{room.area}㎡</dd></div><div><dt>전망</dt><dd>시티뷰</dd></div><div><dt>침대</dt><dd>{room.bed}</dd></div><div><dt>욕조</dt><dd>객실 내 원형 욕조</dd></div><div><dt>예약 사이트 객실명</dt><dd>{room.bookingName}</dd></div><div><dt>객실 수</dt><dd>{room.count}실</dd></div></dl><p class="small muted">객실 내 원형 욕조는 지하 프라이빗 욕장과 별도 시설입니다.</p></div><aside class="room-booking"><h3>누베르에서의 하루.</h3><p>예약 가능한 일정과 객실은<br />Booking.com에서 확인하실 수 있습니다.</p><BookingButton /><p class="small muted">예약 시 투숙 정원과 이용 조건을 확인해 주세요. 스피커 제공 객실 및 모델은 확인 후 안내합니다.</p></aside></section>
  <div class="container related-room"><span class="muted">또 다른 휴식의 공간</span><a href={withBase(`rooms/${other.slug}/`)}>{other.name} <span aria-hidden="true">↗</span></a><a class="text-link" href={withBase('rooms/')}>객실 목록으로 <span aria-hidden="true">←</span></a></div>
</BaseLayout>
